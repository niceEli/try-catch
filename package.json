		"tsup": "8.4.0",
		"typescript": "5.8.2",
		"typescript-eslint": "8.26.1",
		"vitest": "^3.1.4"
	},
	"packageManager": "pnpm@10.4.0",
	"engines": {
		"node": ">=18.3.0"
	}
