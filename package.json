	"description": "A Go Like try-catch System",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/niceEli/try-catch.git"
	},
	"private": "false",
	"license": "MIT",
	"author": "niceEli",
	"type": "module",
	"main": "lib/index.js",
	"files": [
